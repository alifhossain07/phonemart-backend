<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marquee Announcements - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <%- include('_header') %>
    <div class="flex">
        <%- include('_sidebar', { page: 'marquee' }) %>
        <main class="flex-1 p-8">
            <h1 class="text-3xl font-bold mb-6">Marquee Announcements</h1>
            
            <% if (typeof query !== 'undefined' && query.success === '1') { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                    Marquee item saved successfully!
                </div>
            <% } %>
            <% if (typeof query !== 'undefined' && query.error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                    <%= query.error %>
                </div>
            <% } %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Add New Marquee Item -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">Add New Announcement</h2>
                    <form method="POST" action="/admin/marquee">
                        <div class="mb-4">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Announcement Text *</label>
                            <textarea 
                                name="text" 
                                required
                                rows="3"
                                class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                placeholder="e.g., 🎉 Special Offer: 50% off on all accessories! Limited time only!"
                            ></textarea>
                            <p class="text-xs text-gray-500 mt-1">This text will scroll continuously in the top bar</p>
                        </div>

                        <div class="mb-4">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Order</label>
                            <input 
                                type="number" 
                                name="order" 
                                value="0"
                                class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            />
                            <p class="text-xs text-gray-500 mt-1">Lower numbers appear first</p>
                        </div>

                        <div class="mb-4">
                            <label class="flex items-center">
                                <input type="checkbox" name="active" class="mr-2" checked>
                                <span class="text-gray-700 text-sm font-bold">Active (Multiple announcements can be active and will display sequentially)</span>
                            </label>
                        </div>

                        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded w-full">
                            <i class="fas fa-plus mr-2"></i>Add Announcement
                        </button>
                    </form>
                </div>

                <!-- All Marquee Items -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">All Announcements</h2>
                    <div class="space-y-3">
                        <% if (marqueeItems && marqueeItems.length > 0) { %>
                            <% marqueeItems.forEach(item => { %>
                                <div class="flex items-center justify-between p-3 border rounded <%= item.active ? 'bg-green-50 border-green-300' : '' %>">
                                    <div class="flex-1">
                                        <div class="font-medium text-gray-900">
                                            <%= item.text %>
                                        </div>
                                        <div class="text-xs text-gray-500 mt-1">
                                            Order: <%= item.order %> | 
                                            <% if (item.active) { %>
                                                <span class="text-green-600 font-semibold">Active</span>
                                            <% } else { %>
                                                <span class="text-gray-400">Inactive</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 ml-4">
                                        <button 
                                            onclick="openEditModal('<%= item._id %>', '<%= item.text.replace(/'/g, "\\'") %>', <%= item.active %>, <%= item.order %>)" 
                                            class="text-blue-600 hover:text-blue-900" 
                                            title="Edit"
                                        >
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form method="POST" action="/admin/marquee/<%= item._id %>/delete" class="inline" onsubmit="return confirm('Are you sure you want to delete this announcement?')">
                                            <button type="submit" class="text-red-600 hover:text-red-900" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-gray-500 text-center py-4">No announcements found</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Edit Modal -->
            <div id="editModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50 flex items-center justify-center">
                <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-2xl font-bold text-gray-800">Edit Announcement</h2>
                            <button onclick="closeEditModal()" class="text-gray-500 hover:text-gray-700">
                                <i class="fas fa-times text-xl"></i>
                            </button>
                        </div>

                        <form id="editForm" method="POST">
                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Announcement Text *</label>
                                <textarea 
                                    id="editText"
                                    name="text" 
                                    required
                                    rows="3"
                                    class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                ></textarea>
                            </div>

                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Order</label>
                                <input 
                                    type="number" 
                                    id="editOrder"
                                    name="order" 
                                    class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                />
                            </div>

                            <div class="mb-4">
                                <label class="flex items-center">
                                    <input type="checkbox" id="editActive" name="active" class="mr-2">
                                    <span class="text-gray-700 text-sm font-bold">Active</span>
                                </label>
                            </div>

                            <div class="flex gap-3">
                                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded flex-1">
                                    <i class="fas fa-save mr-2"></i>Update
                                </button>
                                <button type="button" onclick="closeEditModal()" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded flex-1">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function openEditModal(id, text, active, order) {
            document.getElementById('editForm').action = `/admin/marquee/${id}`;
            document.getElementById('editText').value = text;
            document.getElementById('editOrder').value = order;
            document.getElementById('editActive').checked = active;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        // Close modal on outside click
        document.getElementById('editModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeEditModal();
            }
        });
    </script>
</body>
</html>

