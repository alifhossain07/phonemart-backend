<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Settings - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <%- include('_header') %>
    <div class="flex">
        <%- include('_sidebar', { page: 'settings' }) %>
        <main class="flex-1 p-8">
            <h1 class="text-3xl font-bold mb-6">Business Settings</h1>
            <% if (typeof query !== 'undefined' && query.success === '1') { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                    Settings updated successfully!
                </div>
            <% } %>
            <div class="bg-white rounded-lg shadow p-6">
                <form method="POST" action="/admin/settings">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold mb-2">Header Logo URL</label>
                            <input type="url" name="header_logo" value="<%= settings.header_logo || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Footer Logo URL</label>
                            <input type="url" name="footer_logo" value="<%= settings.footer_logo || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-bold mb-2">About Us Description</label>
                            <textarea name="about_us_description" class="w-full border rounded px-4 py-2"><%= settings.about_us_description || '' %></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Copyright Text</label>
                            <input type="text" name="frontend_copyright_text" value="<%= settings.frontend_copyright_text || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Contact Phone</label>
                            <input type="text" name="contact_phone" value="<%= settings.contact_phone || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Contact Email</label>
                            <input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-bold mb-2">Contact Address</label>
                            <textarea name="contact_address" class="w-full border rounded px-4 py-2"><%= settings.contact_address || '' %></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Facebook Link</label>
                            <input type="url" name="facebook_link" value="<%= settings.facebook_link || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Instagram Link</label>
                            <input type="url" name="instagram_link" value="<%= settings.instagram_link || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Twitter Link</label>
                            <input type="url" name="twitter_link" value="<%= settings.twitter_link || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">YouTube Link</label>
                            <input type="url" name="youtube_link" value="<%= settings.youtube_link || '' %>" class="w-full border rounded px-4 py-2">
                        </div>
                    </div>
                    <button type="submit" class="mt-6 bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded">Save Settings</button>
                </form>
            </div>

            <!-- Shipping Configuration -->
            <div class="bg-white rounded-lg shadow p-6 mt-6">
                <h2 class="text-xl font-bold mb-4">Shipping Configuration</h2>
                <form method="POST" action="/admin/settings/shipping">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold mb-2">Inside Dhaka Shipping Cost (৳)</label>
                            <input type="number" name="shipping_cost_inside_dhaka" value="<%= typeof shippingConfig !== 'undefined' && shippingConfig.shipping_cost_inside_dhaka ? shippingConfig.shipping_cost_inside_dhaka : '60' %>" class="w-full border rounded px-4 py-2" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Outside Dhaka Shipping Cost (৳)</label>
                            <input type="number" name="shipping_cost_outside_dhaka" value="<%= typeof shippingConfig !== 'undefined' && shippingConfig.shipping_cost_outside_dhaka ? shippingConfig.shipping_cost_outside_dhaka : '140' %>" class="w-full border rounded px-4 py-2" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Free Shipping Minimum Amount (৳)</label>
                            <input type="number" name="free_shipping_min_amount" value="<%= typeof shippingConfig !== 'undefined' && shippingConfig.free_shipping_min_amount ? shippingConfig.free_shipping_min_amount : '0' %>" class="w-full border rounded px-4 py-2" required>
                            <p class="text-xs text-gray-500 mt-1">Set to 0 to disable free shipping</p>
                        </div>
                    </div>
                    <button type="submit" class="mt-6 bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded">Save Shipping Configuration</button>
                </form>
            </div>
        </main>
    </div>
</body>
</html>

