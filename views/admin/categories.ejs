<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - Admin Panel - Like Telecom</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <%- include('_header') %>

    <div class="flex">
        <%- include('_sidebar', { page: 'categories' }) %>

        <main class="flex-1 p-8">
            <div class="mb-6 flex justify-between items-center">
                <h1 class="text-3xl font-bold text-gray-800">Categories</h1>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">Add New Category</h2>
                    <form method="POST" action="/admin/categories">
                        <div class="mb-4">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Category Name *</label>
                            <input type="text" name="name" required
                                   class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div class="mb-4">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Icon URL</label>
                            <input type="url" name="icon"
                                   class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div class="mb-4">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Banner URL</label>
                            <input type="url" name="banner"
                                   class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div class="mb-4">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Order</label>
                            <input type="number" name="order" value="0"
                                   class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>

                        <div class="mb-4">
                            <input type="checkbox" name="featured" class="mr-2"> Featured Category
                        </div>

                        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded w-full">
                            <i class="fas fa-plus mr-2"></i>Add Category
                        </button>
                    </form>
                </div>

                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">All Categories</h2>
                    <div class="space-y-2">
                        <% if (categories && categories.length > 0) { %>
                            <% categories.forEach(category => { %>
                                <div class="flex items-center justify-between p-3 border rounded">
                                    <div>
                                        <div class="font-medium"><%= category.name %></div>
                                        <div class="text-sm text-gray-500"><%= category.slug %></div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button onclick="openCategoryModal('<%= category._id %>')" class="text-blue-600 hover:text-blue-900" title="View/Edit">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <form method="POST" action="/admin/categories/<%= category._id %>/delete" class="inline" onsubmit="return confirm('Are you sure?')">
                                            <button type="submit" class="text-red-600 hover:text-red-900" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-gray-500 text-center">No categories found</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Category Edit Modal -->
            <div id="categoryModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50 flex items-center justify-center">
                <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-2xl font-bold text-gray-800">Category Information</h2>
                            <button onclick="closeCategoryModal()" class="text-gray-500 hover:text-gray-700">
                                <i class="fas fa-times text-xl"></i>
                            </button>
                        </div>

                        <form id="categoryEditForm" onsubmit="updateCategory(event)">
                            <input type="hidden" id="categoryId" name="id">
                            
                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Category Name *</label>
                                <input type="text" id="categoryName" name="name" required
                                       class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                       oninput="updateSlugFromName(this.value)">
                            </div>

                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Slug</label>
                                <input type="text" id="categorySlug" name="slug" readonly
                                       class="w-full border rounded px-4 py-2 bg-gray-100">
                                <p class="text-xs text-gray-500 mt-1">Slug is auto-generated from name</p>
                            </div>

                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Icon URL</label>
                                <input type="url" id="categoryIcon" name="icon"
                                       class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                       oninput="updateIconPreview(this.value)">
                                <div id="iconPreview" class="mt-2"></div>
                            </div>

                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Banner URL</label>
                                <input type="url" id="categoryBanner" name="banner"
                                       class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                       oninput="updateBannerPreview(this.value)">
                                <div id="bannerPreview" class="mt-2"></div>
                            </div>

                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Order</label>
                                <input type="number" id="categoryOrder" name="order" value="0"
                                       class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <div class="mb-4">
                                <label class="flex items-center">
                                    <input type="checkbox" id="categoryFeatured" name="featured" class="mr-2">
                                    <span class="text-gray-700 text-sm font-bold">Featured Category</span>
                                </label>
                            </div>

                            <div class="flex gap-3">
                                <button type="submit" id="updateBtn" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded flex-1">
                                    <i class="fas fa-save mr-2"></i><span id="updateBtnText">Update Category</span>
                                </button>
                                <button type="button" onclick="closeCategoryModal()" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded flex-1">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            </div>
        </main>
    </div>

    <script>
        async function openCategoryModal(categoryId) {
            try {
                const response = await fetch(`/admin/categories/${categoryId}`);
                if (!response.ok) {
                    alert('Failed to load category information');
                    return;
                }
                
                const category = await response.json();
                
                document.getElementById('categoryId').value = category._id || category.id;
                document.getElementById('categoryName').value = category.name || '';
                document.getElementById('categorySlug').value = category.slug || '';
                document.getElementById('categoryIcon').value = category.icon || '';
                document.getElementById('categoryBanner').value = category.banner || '';
                document.getElementById('categoryOrder').value = category.order || 0;
                document.getElementById('categoryFeatured').checked = category.featured || false;
                
                // Preview icon
                const iconPreview = document.getElementById('iconPreview');
                if (category.icon) {
                    iconPreview.innerHTML = `<img src="${category.icon}" alt="Icon" class="h-16 w-16 object-contain border rounded">`;
                } else {
                    iconPreview.innerHTML = '';
                }
                
                // Preview banner
                const bannerPreview = document.getElementById('bannerPreview');
                if (category.banner) {
                    bannerPreview.innerHTML = `<img src="${category.banner}" alt="Banner" class="h-32 w-full object-contain border rounded">`;
                } else {
                    bannerPreview.innerHTML = '';
                }
                
                document.getElementById('categoryModal').classList.remove('hidden');
            } catch (error) {
                console.error('Error loading category:', error);
                alert('Failed to load category information');
            }
        }

        function closeCategoryModal() {
            document.getElementById('categoryModal').classList.add('hidden');
        }

        function generateSlug(text) {
            return text
                .toLowerCase()
                .trim()
                .replace(/[^\w\s-]/g, '')
                .replace(/[\s_-]+/g, '-')
                .replace(/^-+|-+$/g, '');
        }

        function updateSlugFromName(name) {
            if (name) {
                document.getElementById('categorySlug').value = generateSlug(name);
            }
        }

        function updateIconPreview(url) {
            const preview = document.getElementById('iconPreview');
            if (url && url.trim()) {
                preview.innerHTML = `<img src="${url}" alt="Icon Preview" class="h-16 w-16 object-contain border rounded" onerror="this.parentElement.innerHTML='<span class=\'text-red-500 text-xs\'>Invalid image URL</span>'">`;
            } else {
                preview.innerHTML = '';
            }
        }

        function updateBannerPreview(url) {
            const preview = document.getElementById('bannerPreview');
            if (url && url.trim()) {
                preview.innerHTML = `<img src="${url}" alt="Banner Preview" class="h-32 w-full object-contain border rounded" onerror="this.parentElement.innerHTML='<span class=\'text-red-500 text-xs\'>Invalid image URL</span>'">`;
            } else {
                preview.innerHTML = '';
            }
        }

        async function updateCategory(event) {
            event.preventDefault();
            
            const updateBtn = document.getElementById('updateBtn');
            const updateBtnText = document.getElementById('updateBtnText');
            const originalText = updateBtnText.textContent;
            
            // Disable button and show loading
            updateBtn.disabled = true;
            updateBtn.classList.add('opacity-50', 'cursor-not-allowed');
            updateBtnText.textContent = 'Updating...';
            
            const formData = new FormData(event.target);
            const categoryId = formData.get('id');
            const data = {
                name: formData.get('name'),
                icon: formData.get('icon') || null,
                banner: formData.get('banner') || null,
                order: parseInt(formData.get('order')) || 0,
                featured: document.getElementById('categoryFeatured').checked
            };
            
            try {
                const response = await fetch(`/admin/categories/${categoryId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (!response.ok) {
                    alert(result.message || 'Failed to update category');
                    return;
                }
                
                alert('Category updated successfully!');
                closeCategoryModal();
                location.reload();
            } catch (error) {
                console.error('Error updating category:', error);
                alert('Failed to update category');
            } finally {
                // Re-enable button
                updateBtn.disabled = false;
                updateBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                updateBtnText.textContent = originalText;
            }
        }

        // Close modal on outside click
        document.getElementById('categoryModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeCategoryModal();
            }
        });
    </script>
</body>
</html>
