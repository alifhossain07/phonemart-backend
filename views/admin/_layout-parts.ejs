<!-- This file contains reusable layout parts -->
<!-- Sidebar Navigation -->
<% function renderSidebar(currentPage) { %>
<aside class="w-64 bg-gray-800 text-white min-h-screen">
    <nav class="mt-5">
        <a href="/admin/dashboard" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= currentPage === 'dashboard' ? 'bg-gray-700' : '' %>">
            <i class="fas fa-tachometer-alt mr-3"></i>Dashboard
        </a>
        <a href="/admin/products" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= currentPage === 'products' ? 'bg-gray-700' : '' %>">
            <i class="fas fa-box mr-3"></i>Products
        </a>
        <a href="/admin/categories" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= currentPage === 'categories' ? 'bg-gray-700' : '' %>">
            <i class="fas fa-tags mr-3"></i>Categories
        </a>
        <a href="/admin/orders" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= currentPage === 'orders' ? 'bg-gray-700' : '' %>">
            <i class="fas fa-shopping-cart mr-3"></i>Orders
        </a>
    </nav>
</aside>
<% } %>

