<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flash Deals - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <%- include('_header') %>
    <div class="flex">
        <%- include('_sidebar', { page: 'flash-deals' }) %>
        <main class="flex-1 p-8">
            <h1 class="text-3xl font-bold mb-6">Flash Deals</h1>
            
            <!-- Success/Error Messages -->
            <% if (typeof query !== 'undefined' && query.success) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4" role="alert">
                    <span class="block sm:inline"><%= query.success %></span>
                </div>
            <% } %>
            <% if (typeof query !== 'undefined' && query.error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
                    <span class="block sm:inline"><%= query.error %></span>
                </div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
                    <span class="block sm:inline"><%= error %></span>
                </div>
            <% } %>
            
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-bold mb-4">Create Flash Deal</h2>
                <form method="POST" action="/admin/flash-deals" onsubmit="return validateFlashDealForm(this)">
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-bold mb-2">Title *</label>
                            <input type="text" name="title" required class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Banner URL</label>
                            <input type="url" name="banner" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Start Date</label>
                            <input type="datetime-local" name="start_date" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">End Date</label>
                            <input type="datetime-local" name="end_date" class="w-full border rounded px-4 py-2">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Background Color</label>
                            <input type="color" name="background_color" value="#000000" class="w-full border rounded px-4 py-2 h-10">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Text Color</label>
                            <input type="color" name="text_color" value="#ffffff" class="w-full border rounded px-4 py-2 h-10">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-bold mb-2">Products *</label>
                        <% if (products && products.length > 0) { %>
                            <select name="products" id="productSelect" multiple required class="w-full border rounded px-4 py-2 h-32">
                                <% products.forEach(product => { %>
                                    <option value="<%= product._id.toString() %>"><%= product.name %> - ৳<%= product.main_price || product.base_price || 0 %></option>
                                <% }); %>
                            </select>
                            <p class="text-sm text-gray-500 mt-1">Hold Ctrl/Cmd (Windows) or Cmd (Mac) to select multiple products</p>
                            <p class="text-sm text-gray-600 mt-1" id="selectedCount">0 product(s) selected</p>
                        <% } else { %>
                            <div class="border rounded px-4 py-2 h-32 bg-gray-100 flex items-center justify-center">
                                <p class="text-gray-500">No products available. Please add products first.</p>
                            </div>
                            <p class="text-sm text-red-500 mt-1">No products found. Add products from the Products page first.</p>
                        <% } %>
                    </div>
                    <script>
                        // Update selected count when products are selected
                        document.addEventListener('DOMContentLoaded', function() {
                            const productSelect = document.getElementById('productSelect');
                            const selectedCount = document.getElementById('selectedCount');
                            
                            if (productSelect && selectedCount) {
                                productSelect.addEventListener('change', function() {
                                    const selected = this.selectedOptions.length;
                                    selectedCount.textContent = selected + ' product(s) selected';
                                    selectedCount.className = selected > 0 ? 'text-sm text-green-600 mt-1 font-semibold' : 'text-sm text-gray-600 mt-1';
                                });
                            }
                        });
                    </script>
                    <div class="mb-4">
                        <label><input type="checkbox" name="homepage" class="mr-2">Show on Homepage</label>
                        <label class="ml-4"><input type="checkbox" name="status" checked class="mr-2">Active</label>
                    </div>
                    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded">Create Flash Deal</button>
                </form>
            </div>
            <div class="mt-6 bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-bold mb-4">All Flash Deals</h2>
                <div class="space-y-4">
                    <% if (flashDeals && flashDeals.length > 0) { %>
                        <% flashDeals.forEach(deal => { %>
                            <div class="border rounded p-4 flex justify-between items-center">
                                <div>
                                    <h3 class="font-bold"><%= deal.title %></h3>
                                    <p class="text-sm text-gray-600"><%= deal.start_date ? new Date(deal.start_date).toLocaleDateString() : '' %> - <%= deal.end_date ? new Date(deal.end_date).toLocaleDateString() : '' %></p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        Products: <%= deal.products ? deal.products.length : 0 %> | 
                                        Status: <span class="<%= deal.status === 1 ? 'text-green-600' : 'text-gray-500' %>"><%= deal.status === 1 ? 'Active' : 'Inactive' %></span>
                                    </p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button onclick="openFlashDealModal('<%= deal._id %>')" class="text-blue-600 hover:text-blue-900" title="View/Edit">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <form method="POST" action="/admin/flash-deals/<%= deal._id %>/delete" class="inline" onsubmit="return confirm('Are you sure you want to delete this flash deal?')">
                                        <button type="submit" class="text-red-600 hover:text-red-900" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-gray-500">No flash deals</p>
                    <% } %>
                </div>
            </div>

            <!-- Flash Deal Edit Modal -->
            <div id="flashDealModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50 flex items-center justify-center">
                <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full mx-4 max-h-[90vh] overflow-y-auto">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-2xl font-bold text-gray-800">Edit Flash Deal</h2>
                            <button onclick="closeFlashDealModal()" class="text-gray-500 hover:text-gray-700">
                                <i class="fas fa-times text-xl"></i>
                            </button>
                        </div>

                        <form id="flashDealEditForm" onsubmit="updateFlashDeal(event)">
                            <input type="hidden" id="flashDealId" name="id">
                            
                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div>
                                    <label class="block text-sm font-bold mb-2">Title *</label>
                                    <input type="text" id="flashDealTitle" name="title" required class="w-full border rounded px-4 py-2">
                                </div>
                                <div>
                                    <label class="block text-sm font-bold mb-2">Banner URL</label>
                                    <input type="url" id="flashDealBanner" name="banner" class="w-full border rounded px-4 py-2">
                                    <div id="bannerPreview" class="mt-2"></div>
                                </div>
                                <div>
                                    <label class="block text-sm font-bold mb-2">Start Date *</label>
                                    <input type="datetime-local" id="flashDealStartDate" name="start_date" required class="w-full border rounded px-4 py-2">
                                </div>
                                <div>
                                    <label class="block text-sm font-bold mb-2">End Date *</label>
                                    <input type="datetime-local" id="flashDealEndDate" name="end_date" required class="w-full border rounded px-4 py-2">
                                </div>
                                <div>
                                    <label class="block text-sm font-bold mb-2">Background Color</label>
                                    <input type="color" id="flashDealBgColor" name="background_color" value="#000000" class="w-full border rounded px-4 py-2 h-10">
                                </div>
                                <div>
                                    <label class="block text-sm font-bold mb-2">Text Color</label>
                                    <input type="color" id="flashDealTextColor" name="text_color" value="#ffffff" class="w-full border rounded px-4 py-2 h-10">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="block text-sm font-bold mb-2">Products *</label>
                                <select name="products" id="flashDealProductSelect" multiple required class="w-full border rounded px-4 py-2 h-32">
                                    <% if (products && products.length > 0) { %>
                                        <% products.forEach(product => { %>
                                            <option value="<%= product._id %>"><%= product.name %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                                <p class="text-sm text-gray-500 mt-1">Hold Ctrl/Cmd (Windows) or Cmd (Mac) to select multiple products</p>
                                <p class="text-sm text-gray-600 mt-1" id="modalSelectedCount">0 product(s) selected</p>
                            </div>

                            <div class="mb-4">
                                <label class="flex items-center">
                                    <input type="checkbox" id="flashDealHomepage" name="homepage" class="mr-2">
                                    <span class="text-sm font-bold">Show on Homepage</span>
                                </label>
                                <label class="flex items-center mt-2">
                                    <input type="checkbox" id="flashDealStatus" name="status" class="mr-2">
                                    <span class="text-sm font-bold">Active</span>
                                </label>
                            </div>

                            <div class="flex gap-3">
                                <button type="submit" id="updateBtn" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded flex-1">
                                    <i class="fas fa-save mr-2"></i><span id="updateBtnText">Update Flash Deal</span>
                                </button>
                                <button type="button" onclick="closeFlashDealModal()" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded flex-1">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Validate flash deal form
        function validateFlashDealForm(form) {
            const productSelect = form.querySelector('[name="products"]');
            if (productSelect && productSelect.selectedOptions.length === 0) {
                alert('Please select at least one product for the flash deal');
                return false;
            }
            return true;
        }

        // Update selected products count for create form
        const productSelect = document.getElementById('productSelect');
        if (productSelect) {
            productSelect.addEventListener('change', function() {
                const selectedCount = this.selectedOptions.length;
                document.getElementById('selectedCount').textContent = selectedCount + ' product(s) selected';
            });
        }

        // Update selected products count for modal form
        const modalProductSelect = document.getElementById('flashDealProductSelect');
        if (modalProductSelect) {
            modalProductSelect.addEventListener('change', function() {
                const selectedCount = this.selectedOptions.length;
                document.getElementById('modalSelectedCount').textContent = selectedCount + ' product(s) selected';
            });
        }

        // Format date for datetime-local input
        function formatDateTimeForInput(date) {
            if (!date) return '';
            const d = new Date(date);
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            const hours = String(d.getHours()).padStart(2, '0');
            const minutes = String(d.getMinutes()).padStart(2, '0');
            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        async function openFlashDealModal(dealId) {
            try {
                const response = await fetch(`/admin/flash-deals/${dealId}`);
                if (!response.ok) {
                    alert('Failed to load flash deal information');
                    return;
                }
                
                const deal = await response.json();
                
                document.getElementById('flashDealId').value = deal._id || deal.id;
                document.getElementById('flashDealTitle').value = deal.title || '';
                document.getElementById('flashDealBanner').value = deal.banner || '';
                document.getElementById('flashDealStartDate').value = formatDateTimeForInput(deal.start_date);
                document.getElementById('flashDealEndDate').value = formatDateTimeForInput(deal.end_date);
                document.getElementById('flashDealBgColor').value = deal.background_color || '#000000';
                document.getElementById('flashDealTextColor').value = deal.text_color || '#ffffff';
                document.getElementById('flashDealHomepage').checked = deal.homepage === 1 || deal.homepage === true;
                document.getElementById('flashDealStatus').checked = deal.status === 1 || deal.status === true;
                
                // Set selected products
                const productSelect = document.getElementById('flashDealProductSelect');
                // Clear previous selections
                Array.from(productSelect.options).forEach(option => {
                    option.selected = false;
                });
                
                // Select products that are in the deal
                if (deal.products && deal.products.length > 0) {
                    deal.products.forEach(dealProduct => {
                        const productId = dealProduct.product_id?.toString() || dealProduct.product_id;
                        const option = Array.from(productSelect.options).find(opt => opt.value === productId);
                        if (option) {
                            option.selected = true;
                        }
                    });
                }
                
                // Update selected count
                const selectedCount = productSelect.selectedOptions.length;
                document.getElementById('modalSelectedCount').textContent = selectedCount + ' product(s) selected';
                
                // Preview banner
                const bannerPreview = document.getElementById('bannerPreview');
                if (deal.banner) {
                    bannerPreview.innerHTML = `<img src="${deal.banner}" alt="Banner Preview" class="h-32 w-full object-contain border rounded" onerror="this.parentElement.innerHTML='<span class=\'text-red-500 text-xs\'>Invalid image URL</span>'">`;
                } else {
                    bannerPreview.innerHTML = '';
                }
                
                document.getElementById('flashDealModal').classList.remove('hidden');
            } catch (error) {
                console.error('Error loading flash deal:', error);
                alert('Failed to load flash deal information');
            }
        }

        function closeFlashDealModal() {
            document.getElementById('flashDealModal').classList.add('hidden');
        }

        function updateBannerPreview(url) {
            const preview = document.getElementById('bannerPreview');
            if (url && url.trim()) {
                preview.innerHTML = `<img src="${url}" alt="Banner Preview" class="h-32 w-full object-contain border rounded" onerror="this.parentElement.innerHTML='<span class=\'text-red-500 text-xs\'>Invalid image URL</span>'">`;
            } else {
                preview.innerHTML = '';
            }
        }

        // Add event listener for banner preview
        const bannerInput = document.getElementById('flashDealBanner');
        if (bannerInput) {
            bannerInput.addEventListener('input', function() {
                updateBannerPreview(this.value);
            });
        }

        async function updateFlashDeal(event) {
            event.preventDefault();
            
            const productSelect = document.getElementById('flashDealProductSelect');
            const selectedProducts = Array.from(productSelect.selectedOptions).map(option => option.value);
            
            // Validate at least one product is selected
            if (selectedProducts.length === 0) {
                alert('Please select at least one product for the flash deal');
                return;
            }
            
            const updateBtn = document.getElementById('updateBtn');
            const updateBtnText = document.getElementById('updateBtnText');
            const originalText = updateBtnText.textContent;
            
            // Disable button and show loading
            updateBtn.disabled = true;
            updateBtn.classList.add('opacity-50', 'cursor-not-allowed');
            updateBtnText.textContent = 'Updating...';
            
            const formData = new FormData(event.target);
            const dealId = formData.get('id');
            
            const data = {
                title: formData.get('title'),
                banner: formData.get('banner') || null,
                start_date: formData.get('start_date'),
                end_date: formData.get('end_date'),
                background_color: formData.get('background_color') || '#000000',
                text_color: formData.get('text_color') || '#ffffff',
                homepage: document.getElementById('flashDealHomepage').checked,
                status: document.getElementById('flashDealStatus').checked,
                products: selectedProducts
            };
            
            try {
                const response = await fetch(`/admin/flash-deals/${dealId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (!response.ok) {
                    alert(result.message || 'Failed to update flash deal');
                    return;
                }
                
                alert('Flash deal updated successfully!');
                closeFlashDealModal();
                location.reload();
            } catch (error) {
                console.error('Error updating flash deal:', error);
                alert('Failed to update flash deal');
            } finally {
                // Re-enable button
                updateBtn.disabled = false;
                updateBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                updateBtnText.textContent = originalText;
            }
        }

        // Close modal on outside click
        document.getElementById('flashDealModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeFlashDealModal();
            }
        });
    </script>
</body>
</html>

