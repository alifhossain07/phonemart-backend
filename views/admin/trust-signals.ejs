<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trust Signals - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <%- include('_header') %>
    <div class="flex">
        <%- include('_sidebar', { page: 'trust-signals' }) %>
        <main class="flex-1 p-8">
            <h1 class="text-3xl font-bold mb-6">Trust Signals</h1>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-bold mb-4">Add Trust Signal</h2>
                    <form method="POST" action="/admin/trust-signals">
                        <div class="mb-4">
                            <label class="block text-sm font-bold mb-2">Title *</label>
                            <input type="text" name="title" required class="w-full border rounded px-4 py-2">
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-bold mb-2">Icon URL *</label>
                            <input type="url" name="icon" required class="w-full border rounded px-4 py-2">
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-bold mb-2">Description</label>
                            <textarea name="description" class="w-full border rounded px-4 py-2"></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-bold mb-2">Order</label>
                            <input type="number" name="order" value="0" class="w-full border rounded px-4 py-2">
                        </div>
                        <div class="mb-4">
                            <label><input type="checkbox" name="active" checked class="mr-2">Active</label>
                        </div>
                        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded w-full">Add Trust Signal</button>
                    </form>
                </div>
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-bold mb-4">All Trust Signals</h2>
                    <div class="space-y-3">
                        <% if (trustSignals && trustSignals.length > 0) { %>
                            <% trustSignals.forEach(signal => { %>
                                <div class="border rounded p-4 flex justify-between items-center">
                                    <div>
                                        <h3 class="font-bold"><%= signal.title %></h3>
                                        <p class="text-sm text-gray-600"><%= signal.description || '' %></p>
                                    </div>
                                    <form method="POST" action="/admin/trust-signals/<%= signal._id %>/delete" class="inline">
                                        <button type="submit" onclick="return confirm('Delete?')" class="bg-red-500 text-white px-3 py-1 rounded text-sm">Delete</button>
                                    </form>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-gray-500">No trust signals</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>

