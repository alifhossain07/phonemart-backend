<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders - Admin Panel - Like Telecom</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <%- include('_header') %>

    <div class="flex">
        <%- include('_sidebar', { page: 'orders' }) %>

        <main class="flex-1 p-8">
            <div class="mb-6">
                <h1 class="text-3xl font-bold text-gray-800">Orders</h1>
            </div>

            <div class="bg-white rounded-lg shadow mb-6 p-4">
                <form method="GET" action="/admin/orders" class="flex gap-4">
                    <select name="status" class="border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Orders</option>
                        <option value="pending" <%= typeof status !== 'undefined' && status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="processing" <%= typeof status !== 'undefined' && status === 'processing' ? 'selected' : '' %>>Processing</option>
                        <option value="delivered" <%= typeof status !== 'undefined' && status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                        <option value="cancelled" <%= typeof status !== 'undefined' && status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                    <button type="submit" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded">
                        Filter
                    </button>
                </form>
            </div>

            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order Code</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Delivery Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                        <%= order.order_code %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-gray-900">
                                            <%= order.user_id ? order.customer.name : 'Guest' %>
                                        </div>
                                        <div class="text-sm text-gray-500"><%= order.customer.mobile %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        ৳<%= order.final_amount || order.total_amount %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                            <%= order.delivery_status %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= order.payment_status === 'paid' ? 'bg-green-100 text-green-800' : order.payment_status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                                            <%= order.payment_status || 'unpaid' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <%= new Date(order.created_at).toLocaleDateString() %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <div class="flex items-center gap-2">
                                            <button onclick="viewOrderDetails('<%= order._id %>')" 
                                                    class="text-blue-600 hover:text-blue-800 p-1" 
                                                    title="View Order Details">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <form method="POST" action="/admin/orders/<%= order._id %>/status" class="inline">
                                                <select name="delivery_status" onchange="this.form.submit()" 
                                                        class="text-xs border rounded px-2 py-1">
                                                    <option value="pending" <%= order.delivery_status === 'pending' ? 'selected' : '' %>>Pending</option>
                                                    <option value="processing" <%= order.delivery_status === 'processing' ? 'selected' : '' %>>Processing</option>
                                                    <option value="delivered" <%= order.delivery_status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                                    <option value="cancelled" <%= order.delivery_status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                                </select>
                                            </form>
                                            <form method="POST" action="/admin/orders/<%= order._id %>/payment-status" class="inline">
                                                <select name="payment_status" onchange="this.form.submit()" 
                                                        class="text-xs border rounded px-2 py-1">
                                                    <option value="unpaid" <%= (order.payment_status || 'unpaid') === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
                                                    <option value="pending" <%= order.payment_status === 'pending' ? 'selected' : '' %>>Pending</option>
                                                    <option value="paid" <%= order.payment_status === 'paid' ? 'selected' : '' %>>Paid</option>
                                                </select>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-4 text-center text-gray-500">No orders found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (pagination && pagination.last_page > 1) { %>
                <div class="mt-4 flex justify-center">
                    <div class="flex gap-2">
                        <% for (let i = 1; i <= pagination.last_page; i++) { %>
                            <a href="/admin/orders?page=<%= i %>" 
                               class="px-4 py-2 <%= pagination.current_page === i ? 'bg-blue-500 text-white' : 'bg-white text-gray-700' %> rounded hover:bg-blue-100">
                                <%= i %>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </main>
    </div>

    <!-- Order Details Modal -->
    <div id="orderModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
            <div class="sticky top-0 bg-white border-b px-6 py-4 flex justify-between items-center">
                <h2 class="text-2xl font-bold text-gray-800">Order Details</h2>
                <button onclick="closeOrderModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            
            <div id="orderModalContent" class="p-6">
                <div class="flex justify-center items-center py-10">
                    <div class="w-8 h-8 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function viewOrderDetails(orderId) {
            const modal = document.getElementById('orderModal');
            const content = document.getElementById('orderModalContent');
            
            // Show modal with loading
            modal.classList.remove('hidden');
            content.innerHTML = '<div class="flex justify-center items-center py-10"><div class="w-8 h-8 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div></div>';
            
            try {
                const response = await fetch(`/admin/orders/${orderId}`);
                const result = await response.json();
                
                if (result.success && result.data) {
                    const order = result.data;
                    renderOrderDetails(order);
                } else {
                    content.innerHTML = '<div class="text-center py-10 text-red-500">Failed to load order details</div>';
                }
            } catch (error) {
                console.error('Error fetching order details:', error);
                content.innerHTML = '<div class="text-center py-10 text-red-500">Error loading order details</div>';
            }
        }
        
        function renderOrderDetails(order) {
            const content = document.getElementById('orderModalContent');
            
            // Format date
            const orderDate = new Date(order.created_at).toLocaleString();
            
            // Status badges
            const deliveryStatusColors = {
                'pending': 'bg-yellow-100 text-yellow-800',
                'processing': 'bg-blue-100 text-blue-800',
                'delivered': 'bg-green-100 text-green-800',
                'cancelled': 'bg-red-100 text-red-800'
            };
            
            const paymentStatusColors = {
                'paid': 'bg-green-100 text-green-800',
                'unpaid': 'bg-red-100 text-red-800',
                'pending': 'bg-yellow-100 text-yellow-800'
            };
            
            const deliveryStatusClass = deliveryStatusColors[order.delivery_status] || 'bg-gray-100 text-gray-800';
            const paymentStatusClass = paymentStatusColors[order.payment_status] || 'bg-gray-100 text-gray-800';
            
            let itemsHtml = '';
            if (order.items && order.items.length > 0) {
                itemsHtml = order.items.map(item => `
                    <tr class="border-b">
                        <td class="px-4 py-3">
                            ${item.image ? `<img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded">` : '<div class="w-16 h-16 bg-gray-200 rounded"></div>'}
                        </td>
                        <td class="px-4 py-3">
                            <div class="font-medium">${item.name || 'N/A'}</div>
                            ${item.variant ? `<div class="text-sm text-gray-500">${item.variant}</div>` : ''}
                        </td>
                        <td class="px-4 py-3 text-center">${item.qty || 1}</td>
                        <td class="px-4 py-3 text-right">৳${(item.price || 0).toLocaleString()}</td>
                        <td class="px-4 py-3 text-right font-medium">৳${((item.total || item.price || 0) * (item.qty || 1)).toLocaleString()}</td>
                    </tr>
                `).join('');
            } else {
                itemsHtml = '<tr><td colspan="5" class="px-4 py-3 text-center text-gray-500">No items found</td></tr>';
            }
            
            content.innerHTML = `
                <!-- Order Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <h3 class="text-lg font-semibold mb-2">Order Information</h3>
                        <div class="space-y-2 text-sm">
                            <div><span class="font-medium">Order Code:</span> <span class="text-gray-700">${order.order_code || 'N/A'}</span></div>
                            <div><span class="font-medium">Order Date:</span> <span class="text-gray-700">${orderDate}</span></div>
                            <div><span class="font-medium">Delivery Status:</span> 
                                <span class="px-2 py-1 rounded-full text-xs font-semibold ${deliveryStatusClass}">
                                    ${(order.delivery_status || 'pending').toUpperCase()}
                                </span>
                            </div>
                            <div><span class="font-medium">Payment Status:</span> 
                                <span class="px-2 py-1 rounded-full text-xs font-semibold ${paymentStatusClass}">
                                    ${(order.payment_status || 'unpaid').toUpperCase()}
                                </span>
                            </div>
                            <div><span class="font-medium">Payment Method:</span> <span class="text-gray-700">${order.payment_method || 'N/A'}</span></div>
                            ${order.shipping_method ? `<div><span class="font-medium">Shipping Method:</span> <span class="text-gray-700">${order.shipping_method}</span></div>` : ''}
                            ${order.shipping_zone ? `<div><span class="font-medium">Shipping Zone:</span> <span class="text-gray-700">${order.shipping_zone}</span></div>` : ''}
                            ${order.promo_code ? `<div><span class="font-medium">Promo Code:</span> <span class="text-gray-700">${order.promo_code}</span></div>` : ''}
                        </div>
                    </div>
                    
                    <div>
                        <h3 class="text-lg font-semibold mb-2">Customer Information</h3>
                        <div class="space-y-2 text-sm">
                            <div><span class="font-medium">Name:</span> <span class="text-gray-700">${order.customer?.name || 'N/A'}</span></div>
                            <div><span class="font-medium">Mobile:</span> <span class="text-gray-700">${order.customer?.mobile || 'N/A'}</span></div>
                            ${order.customer?.email ? `<div><span class="font-medium">Email:</span> <span class="text-gray-700">${order.customer.email}</span></div>` : ''}
                            <div><span class="font-medium">Address:</span> <span class="text-gray-700">${order.customer?.address || 'N/A'}</span></div>
                            ${order.customer?.postal_code ? `<div><span class="font-medium">Postal Code:</span> <span class="text-gray-700">${order.customer.postal_code}</span></div>` : ''}
                            ${order.user_id ? `<div><span class="font-medium">Account:</span> <span class="text-gray-700">Registered User</span></div>` : '<div><span class="font-medium">Account:</span> <span class="text-gray-700">Guest Checkout</span></div>'}
                        </div>
                    </div>
                </div>
                
                <!-- Order Items -->
                <div class="mb-6">
                    <h3 class="text-lg font-semibold mb-3">Order Items</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Image</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Quantity</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Unit Price</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                ${itemsHtml}
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Order Summary -->
                <div class="border-t pt-4">
                    <h3 class="text-lg font-semibold mb-3">Order Summary</h3>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Subtotal:</span>
                            <span class="font-medium">৳${(order.total_amount || 0).toLocaleString()}</span>
                        </div>
                        ${order.discount_amount > 0 ? `
                        <div class="flex justify-between text-green-600">
                            <span>Discount:</span>
                            <span class="font-medium">-৳${order.discount_amount.toLocaleString()}</span>
                        </div>
                        ` : ''}
                        <div class="flex justify-between">
                            <span class="text-gray-600">Shipping Cost:</span>
                            <span class="font-medium">৳${(order.shipping_cost || 0).toLocaleString()}</span>
                        </div>
                        <div class="flex justify-between text-lg font-bold border-t pt-2 mt-2">
                            <span>Total Amount:</span>
                            <span class="text-blue-600">৳${(order.final_amount || 0).toLocaleString()}</span>
                        </div>
                    </div>
                </div>
                
                ${order.note ? `
                <div class="mt-4 border-t pt-4">
                    <h3 class="text-lg font-semibold mb-2">Note</h3>
                    <p class="text-sm text-gray-700">${order.note}</p>
                </div>
                ` : ''}
            `;
        }
        
        function closeOrderModal() {
            document.getElementById('orderModal').classList.add('hidden');
        }
        
        // Close modal when clicking outside
        document.getElementById('orderModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeOrderModal();
            }
        });
        
        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeOrderModal();
            }
        });
    </script>
</body>
</html>
