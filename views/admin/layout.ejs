<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Admin Panel - Like Telecom</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center space-x-4">
                    <a href="/admin/dashboard" class="text-2xl font-bold text-blue-600">Like Telecom Admin</a>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-gray-700"><i class="fas fa-user-circle mr-2"></i><%= admin.name %></span>
                    <a href="/admin/logout" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-gray-800 text-white min-h-screen">
            <nav class="mt-5">
                <a href="/admin/dashboard" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= typeof page !== 'undefined' && page === 'dashboard' ? 'bg-gray-700' : '' %>">
                    <i class="fas fa-tachometer-alt mr-3"></i>Dashboard
                </a>
                <a href="/admin/products" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= typeof page !== 'undefined' && page === 'products' ? 'bg-gray-700' : '' %>">
                    <i class="fas fa-box mr-3"></i>Products
                </a>
                <a href="/admin/categories" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= typeof page !== 'undefined' && page === 'categories' ? 'bg-gray-700' : '' %>">
                    <i class="fas fa-tags mr-3"></i>Categories
                </a>
                <a href="/admin/orders" class="flex items-center px-6 py-3 hover:bg-gray-700 <%= typeof page !== 'undefined' && page === 'orders' ? 'bg-gray-700' : '' %>">
                    <i class="fas fa-shopping-cart mr-3"></i>Orders
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-8">
            <%- typeof body !== 'undefined' ? body : '' %>
        </main>
    </div>
</body>
</html>

