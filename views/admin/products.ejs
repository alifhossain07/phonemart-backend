<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - Admin Panel - Like Telecom</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
    <%- include('_header') %>

    <div class="flex">
        <%- include('_sidebar', { page: 'products' }) %>

        <main class="flex-1 p-8">
            <div class="mb-6 flex justify-between items-center">
                <h1 class="text-3xl font-bold text-gray-800">Products</h1>
                <a href="/admin/products/new" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded">
                    <i class="fas fa-plus mr-2"></i>Add New Product
                </a>
            </div>

            <div class="bg-white rounded-lg shadow mb-6 p-4">
                <form method="GET" action="/admin/products" class="flex gap-4">
                    <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search products..." 
                           class="flex-1 border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <button type="submit" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded">
                        <i class="fas fa-search mr-2"></i>Search
                    </button>
                </form>
            </div>

            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (products && products.length > 0) { %>
                            <% products.forEach(product => { %>
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <% if (product.thumbnail_image) { %>
                                                <img src="<%= product.thumbnail_image %>" alt="<%= product.name %>" class="h-10 w-10 rounded object-cover mr-3">
                                            <% } %>
                                            <div>
                                                <div class="text-sm font-medium text-gray-900"><%= product.name %></div>
                                                <div class="text-sm text-gray-500"><%= product.slug %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        ৳<%= product.base_price || product.main_price || 0 %>
                                        <% if (product.discount_type && product.discount_value) { %>
                                            <span class="text-xs text-green-600 ml-2">
                                                (<%= product.discount_type === 'percentage' ? product.discount_value + '%' : '৳' + product.discount_value %> off)
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        <%= product.current_stock || 0 %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <% if (product.published) { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Published</span>
                                        <% } else { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Draft</span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <a href="/admin/products/<%= product._id %>/edit" class="text-blue-600 hover:text-blue-900 mr-3">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form method="POST" action="/admin/products/<%= product._id %>/delete" class="inline" onsubmit="return confirm('Are you sure?')">
                                            <button type="submit" class="text-red-600 hover:text-red-900">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="px-6 py-4 text-center text-gray-500">No products found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (pagination && pagination.last_page > 1) { %>
                <div class="mt-4 flex justify-center">
                    <div class="flex gap-2">
                        <% for (let i = 1; i <= pagination.last_page; i++) { %>
                            <a href="/admin/products?page=<%= i %>" 
                               class="px-4 py-2 <%= pagination.current_page === i ? 'bg-blue-500 text-white' : 'bg-white text-gray-700' %> rounded hover:bg-blue-100">
                                <%= i %>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </main>
    </div>
</body>
</html>
