                        <h3 class="text-lg font-bold text-gray-800 mb-4">Banner Highlights - Right Banner</h3>
                        <% const highlightsRightBanner = banners.find(b => b.type === 'banner-highlights-right'); %>
                        <% if (highlightsRightBanner) { %>
                            <div class="mb-4 border rounded p-4">
                                <img src="<%= highlightsRightBanner.photo %>" alt="Right Banner" class="w-full h-32 object-contain rounded mb-2">
                                <form method="POST" action="/admin/banners/<%= highlightsRightBanner._id %>/delete" class="inline">
                                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm" onclick="return confirm('Delete this banner?')">
