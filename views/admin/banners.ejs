                                <input type="url" name="photo" value="<%= highlightsRightBanner ? highlightsRightBanner.photo : '' %>" required
                                       class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <% if (highlightsRightBanner && highlightsRightBanner.url) { %>
                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Link URL (Optional)</label>
                                <input type="url" name="url" value="<%= highlightsRightBanner.url %>"
