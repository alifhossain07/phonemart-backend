                            </div>
                            <% if (heroRightBanner && heroRightBanner.url) { %>
                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Link URL (Optional)</label>
                                <input type="url" name="url" value="<%= heroRightBanner.url %>"
                                       class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <% } else { %>
                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-bold mb-2">Link URL (Optional)</label>
                                <input type="url" name="url"
                                       class="w-full border rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <% } %>
                            <div class="mb-4">
                                <label class="flex items-center">
                                    <input type="checkbox" name="active" <%= heroRightBanner ? (heroRightBanner.active ? 'checked' : '') : 'checked' %> class="mr-2">
                                    <span class="text-gray-700">Active</span>
                                </label>
                            </div>
                            <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded w-full">
                                <i class="fas fa-<%= heroRightBanner ? 'save' : 'plus' %> mr-2"></i><%= heroRightBanner ? 'Update' : 'Add' %> Right Banner
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Banner Highlights Banners -->
            <div class="mb-8">
